set shell := ["bash", "-uc"]

# ==============================================================================
# vLLM Server Recipes
# ==============================================================================

_serve_vllm *args:
    #!/usr/bin/env bash
    set -euo pipefail
    set -- {{args}}
    port="8000"
    max_model_len="65536"
    attn_backend="TRITON_ATTN"
    model="google/gemma-4-E4B-it"
    drafter="google/gemma-4-E4B-it-assistant"
    max_lora_rank="32"
    kv_offloading_backend="native"
    kv_offloading_size="20"
    num_spec=""
    lora_args=()
    extra=()

    while [ $# -gt 0 ]; do
      case "$1" in
        port=*|PORT=*) port="${1#*=}"; shift ;;
        max_model_len=*|MAX_MODEL_LEN=*) max_model_len="${1#*=}"; shift ;;
        attn_backend=*|ATTN_BACKEND=*|ab=*) attn_backend="${1#*=}"; shift ;;
        model=*|MODEL=*) model="${1#*=}"; shift ;;
        drafter=*|DRAFTER=*) drafter="${1#*=}"; shift ;;
        max_lora_rank=*|MAX_LORA_RANK=*) max_lora_rank="${1#*=}"; shift ;;
        kv_offloading_backend=*|KV_OFFLOADING_BACKEND=*) kv_offloading_backend="${1#*=}"; shift ;;
        kv_offloading_size=*|KV_OFFLOADING_SIZE=*|kv=*) kv_offloading_size="${1#*=}"; shift ;;
        num_spec=*|NUM_SPEC=*) num_spec="${1#*=}"; shift ;;
        --lora-module|--lora-modules) shift; lora_args+=("$1"); shift ;;
        [0-9]) num_spec="$1"; shift ;;
        *) extra+=("$1"); shift ;;
      esac
    done

    lora_flags=()
    if [ "${#lora_args[@]}" -gt 0 ]; then
      lora_flags=(--lora-modules "${lora_args[@]}")
    fi

    spec_flags=()
    if [ -n "$num_spec" ] && [ "$num_spec" != "0" ]; then
      spec_flags=(--speculative-config "{\"method\": \"mtp\", \"model\": \"$drafter\", \"num_speculative_tokens\": $num_spec}")
    fi

    exec vllm serve "$model" \
      --port "$port" \
      --max-model-len "$max_model_len" \
      --attention-backend "$attn_backend" \
      --kv-offloading-backend "$kv_offloading_backend" \
      --kv-offloading-size "$kv_offloading_size" \
      --enable-auto-tool-choice \
      --tool-call-parser gemma4 \
      --reasoning-parser gemma4 \
      --exclude-tools-when-tool-choice-none \
      --enable-lora \
      --max-lora-rank "$max_lora_rank" \
      ${lora_flags[@]+"${lora_flags[@]}"} \
      ${spec_flags[@]+"${spec_flags[@]}"} \
      ${extra[@]+"${extra[@]}"}

# 1. vllm-final: Serve Gemma 4 + grafting (lambda=1) & simple-lora-sft from /content/bucket/final
vllm-final *args:
    just _serve_vllm {{args}} \
      --lora-modules "grafting-lr-1e4-lam-1=/content/bucket/final/grafting-lr-1e4-lam-1" \
      --lora-modules "simple-lora-1e4=/content/bucket/final/simple-lora-1e4"

