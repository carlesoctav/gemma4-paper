# New task: TermGrade evaluator (terminus-2 agent)
_eval_termgrade default_k default_models *args:
    #!/usr/bin/env bash
    set -euo pipefail
    part="eval_tasks/termgrade-100"
    n="8"
    k="{{default_k}}"
    tag=""
    prefix=""
    job_name=""
    jobs_dir="jobs"
    base_url="http://127.0.0.1:8000/v1"
    lora=""
    model_name=""
    upload_flag="--upload"
    extra=()

    for arg in {{args}}; do
      case "$arg" in
        part=*|PART=*) part="${arg#*=}" ;;
        n=*|N=*) n="${arg#*=}" ;;
        k=*|K=*) k="${arg#*=}" ;;
        tag=*|TAG=*) tag="${arg#*=}" ;;
        prefix=*|PREFIX=*) prefix="${arg#*=}" ;;
        job_name=*|JOB_NAME=*) job_name="${arg#*=}" ;;
        jobs_dir=*|JOBS_DIR=*) jobs_dir="${arg#*=}" ;;
        base_url=*|BASE_URL=*) base_url="${arg#*=}" ;;
        lora=*|LORA=*) lora="${arg#*=}" ;;
        m=*|M=*|model=*|models=*|model_name=*|MODEL=*|MODELS=*) model_name="${arg#*=}" ;;
        --no-upload|no_upload=true|upload=false) upload_flag="" ;;
        --upload|upload=true) upload_flag="--upload" ;;
        *) extra+=("$arg") ;;
      esac
    done

    export DOCKER_HOST="${DOCKER_HOST:-unix:///run/user/1001/podman/podman.sock}"
    export PATH="/root/.local/bin:$PATH"
    export PYTHONPATH="$PWD:${PYTHONPATH:-}"
    export OPENAI_API_KEY="${OPENAI_API_KEY:-EMPTY}"

    mkdir -p "$jobs_dir"

    models_to_eval=()
    if [ -n "$model_name" ]; then
      for m in ${model_name//,/ }; do
        models_to_eval+=("$m")
      done
    elif [ -n "$lora" ]; then
      for m in ${lora//,/ }; do
        models_to_eval+=("$m")
      done
    else
      for m in {{default_models}}; do
        models_to_eval+=("$m")
      done
    fi

    total="${#models_to_eval[@]}"
    idx=0
    for m in "${models_to_eval[@]}"; do
      idx=$((idx + 1))
      clean_m="${m#openai/}"
      clean_m="${clean_m//\//-}"
      clean_p="${part#./}"
      clean_p="${clean_p//\//-}"

      if [ -n "$job_name" ] && [ "$total" -eq 1 ]; then
        cur_job_name="$job_name"
      else
        cur_job_name="${clean_m}-${clean_p}"
        [ -n "$tag" ] && cur_job_name="${cur_job_name}-${tag}"
        [ "$k" -gt 1 ] && cur_job_name="${cur_job_name}-pass${k}"
      fi
      [ -n "$prefix" ] && cur_job_name="${prefix}${cur_job_name}"

      m_flag="openai/${m#openai/}"

      echo "========================================================================"
      echo "[$idx/$total] TermGrade Eval: $m (job: $cur_job_name, n: $n, k: $k)"
      echo "========================================================================"

      harbor run -a terminus-2 \
        -m "$m_flag" \
        --base-url "$base_url" \
        --ak model_info='{"max_input_tokens": 49152}' \
        --ak proactive_summarization_threshold=16384 \
        --ak llm_call_kwargs='{"chat_template_kwargs": {"enable_thinking": true}}' \
        -p "$part" \
        -n "$n" \
        -k "$k" \
        --job-name "$cur_job_name" \
        --jobs-dir "$jobs_dir" \
        ${upload_flag:+"$upload_flag"} \
        ${extra[@]+"${extra[@]}"}
    done

# Old task: GitHub PR evaluator (pi:PiTinker agent)
_eval_gh_pr default_k default_models *args:
    #!/usr/bin/env bash
    set -euo pipefail
    part="eval_tasks/gemma4_gh_pr"
    n="8"
    k="{{default_k}}"
    tag=""
    prefix=""
    job_name=""
    jobs_dir="jobs"
    base_url="http://127.0.0.1:8000/v1"
    agent="pi:PiTinker"
    lora=""
    model_name=""
    upload_flag="--upload"
    extra=()

    for arg in {{args}}; do
      case "$arg" in
        part=*|PART=*) part="${arg#*=}" ;;
        n=*|N=*) n="${arg#*=}" ;;
        k=*|K=*) k="${arg#*=}" ;;
        tag=*|TAG=*) tag="${arg#*=}" ;;
        prefix=*|PREFIX=*) prefix="${arg#*=}" ;;
        job_name=*|JOB_NAME=*) job_name="${arg#*=}" ;;
        jobs_dir=*|JOBS_DIR=*) jobs_dir="${arg#*=}" ;;
        base_url=*|BASE_URL=*) base_url="${arg#*=}" ;;
        agent=*|AGENT=*) agent="${arg#*=}" ;;
        lora=*|LORA=*) lora="${arg#*=}" ;;
        m=*|M=*|model=*|models=*|model_name=*|MODEL=*|MODELS=*) model_name="${arg#*=}" ;;
        --no-upload|no_upload=true|upload=false) upload_flag="" ;;
        --upload|upload=true) upload_flag="--upload" ;;
        *) extra+=("$arg") ;;
      esac
    done

    export DOCKER_HOST="${DOCKER_HOST:-unix:///run/user/1001/podman/podman.sock}"
    export PATH="/root/.local/bin:$PATH"
    export PYTHONPATH="$PWD:${PYTHONPATH:-}"
    export OPENAI_API_KEY="${OPENAI_API_KEY:-EMPTY}"

    mkdir -p "$jobs_dir"

    models_to_eval=()
    if [ -n "$model_name" ]; then
      for m in ${model_name//,/ }; do
        models_to_eval+=("$m")
      done
    elif [ -n "$lora" ]; then
      for m in ${lora//,/ }; do
        models_to_eval+=("$m")
      done
    else
      for m in {{default_models}}; do
        models_to_eval+=("$m")
      done
    fi

    total="${#models_to_eval[@]}"
    idx=0
    for m in "${models_to_eval[@]}"; do
      idx=$((idx + 1))
      clean_m="${m#openai/}"
      clean_m="${clean_m//\//-}"
      clean_p="${part#./}"
      clean_p="${clean_p//\//-}"

      if [ -n "$job_name" ] && [ "$total" -eq 1 ]; then
        cur_job_name="$job_name"
      else
        cur_job_name="${clean_m}-${clean_p}"
        [ -n "$tag" ] && cur_job_name="${cur_job_name}-${tag}"
        [ "$k" -gt 1 ] && cur_job_name="${cur_job_name}-pass${k}"
      fi
      [ -n "$prefix" ] && cur_job_name="${prefix}${cur_job_name}"

      m_flag="openai/${m#openai/}"

      echo "========================================================================"
      echo "[$idx/$total] GH PR Eval: $m (job: $cur_job_name, n: $n, k: $k)"
      echo "========================================================================"

      harbor run -a "$agent" \
        -m "$m_flag" \
        --base-url "$base_url" \
        --api-format openai_chat_completions \
        --skip-credential-checks \
        --ak skip_install=true \
        -p "$part" \
        -n "$n" \
        -k "$k" \
        --job-name "$cur_job_name" \
        --jobs-dir "$jobs_dir" \
        ${upload_flag:+"$upload_flag"} \
        ${extra[@]+"${extra[@]}"}
    done


