# Evaluate oracle agent on new task (TermGrade)
harbor-new-oracle *args:
    #!/usr/bin/env bash
    set -euo pipefail
    part="eval_tasks/termgrade-100"
    n="8"
    prefix=""
    job_name="oracle-eval_tasks-termgrade-100"
    jobs_dir="jobs"
    upload_flag="--upload"
    extra=()

    for arg in {{args}}; do
      case "$arg" in
        part=*|PART=*) part="${arg#*=}" ;;
        n=*|N=*) n="${arg#*=}" ;;
        prefix=*|PREFIX=*) prefix="${arg#*=}" ;;
        job_name=*|JOB_NAME=*) job_name="${arg#*=}" ;;
        jobs_dir=*|JOBS_DIR=*) jobs_dir="${arg#*=}" ;;
        --no-upload|no_upload=true|upload=false) upload_flag="" ;;
        --upload|upload=true) upload_flag="--upload" ;;
        *) extra+=("$arg") ;;
      esac
    done

    export DOCKER_HOST="${DOCKER_HOST:-unix:///run/user/1001/podman/podman.sock}"
    export PATH="/root/.local/bin:$PATH"
    export PYTHONPATH="$PWD:${PYTHONPATH:-}"

    mkdir -p "$jobs_dir"
    cur_job_name="${prefix}${job_name}"

    harbor run -a oracle \
      -p "$part" \
      -n "$n" \
      --job-name "$cur_job_name" \
      --jobs-dir "$jobs_dir" \
      ${upload_flag:+"$upload_flag"} \
      ${extra[@]+"${extra[@]}"}

