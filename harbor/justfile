      --lora-modules "grafting-lr-1e4-lam-1-checkpoint-50=/content/bucket/final/grafting-lr-1e4-lam-1-checkpoint-50" \
      --lora-modules "grafting-lr-1e4-lam-1-checkpoint-75=/content/bucket/final/grafting-lr-1e4-lam-1-checkpoint-75" \
      --lora-modules "simple-lora-1e4-checkpoint-50=/content/bucket/final/simple-lora-1e4-checkpoint-50" \
